pipeline {
    agent any

    environment {
        GIT_REPO = 'https://github.com/thiyagarajan2002/Jenkins_pipeline.git'
        GIT_BRANCH = 'main'  // Update to your correct branch
    }

    stages {

        stage('Clone Repository') {
            steps {
                script {
                    // Cloning the repository for a public repo without credentials
                    git url: env.GIT_REPO, branch: env.GIT_BRANCH
                }
            }
        }

        stage("Parallel") {
            parallel {

                stage('Build') {
                    steps {
                        script {
                            sh 'docker build -t python_app .'
                            sh 'docker run -p 5000:5000 python_app'
                        }
                    }
                }

                stage('Test') {
                    steps {
                        script {
                            sh 'sleep 30'
                            sh 'chmod +x test.sh && ./test.sh'
                        }
                    }
                }
                 stage('stop') {
                    steps {
                        script {
                            sh 'sleep 40'
                            sh 'docker stop $(docker ps -q)'
                        }
                    }
                }
            }
        }
    }

    post {
        success {
            echo 'Pipeline successfully completed!'
        }
        failure {
            echo 'Pipeline failed, please check the logs.'
        }
    }
}
